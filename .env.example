# Template des variables d'environnement.
# Copier ce fichier vers .env.local puis remplir les valeurs.
# Ne JAMAIS committer de vraies cles ici : ce fichier EST versionne (placeholders vides uniquement).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Verrou d'accès simple (un seul mot de passe partagé) — laisser vide en dev local,
# obligatoire dès que le CRM est déployé publiquement (cf. middleware.ts).
SITE_PASSWORD=
